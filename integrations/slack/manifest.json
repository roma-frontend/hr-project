{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "Strata HR",
    "description": "Leave, expense and new-hire notifications from your Strata workspace.",
    "background_color": "#2c8cd5"
  },
  "features": {
    "bot_user": {
      "display_name": "Strata",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["incoming-webhook"]
    }
  },
  "settings": {
    "incoming_webhooks": {
      "incoming_webhooks_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}

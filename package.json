{
  "name": "office",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0 <25",
    "npm": ">=10.0.0"
  },
  "browserslist": [
    "Chrome >= 111",
    "Firefox >= 115",
    "Safari >= 16.4",
    "Edge >= 111",
    "iOS >= 16.4",
    "not dead",
    "not op_mini all"
  ],
  "overrides": {
    "minimatch@^10": {
      "brace-expansion": "^5.0.9"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "next build && node scripts/check-bundle-guardrails.mjs",
    "check:bundle": "node scripts/check-bundle-guardrails.mjs",
    "build:analyze": "ANALYZE=true next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:strict": "eslint --max-warnings 0",
    "type-check": "tsc --noEmit",
    "type-check:ci": "tsc --noEmit -p tsconfig.verify.json",
    "type-check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "check:locales": "node scripts/check-locale-parity.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "audit:convex-auth": "node scripts/audit-convex-auth.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:serve": "node scripts/coverage-dashboard.mjs",
    "perf": "npm run build && npm run start",
    "test:delete-employees": "tsx scripts/delete-test-employees.ts",
    "test:add-org": "tsx scripts/add-test-org-data.ts",
    "stripe:view": "tsx scripts/view-stripe-transactions.ts",
    "stripe:add-test-data": "tsx scripts/add-test-stripe-data.ts",
    "stripe:export": "tsx scripts/export-stripe-to-excel.ts",
    "stripe:export-pdf": "tsx scripts/export-stripe-to-pdf.ts",
    "stripe:growth-chart": "tsx scripts/stripe-growth-chart.ts",
    "stripe:sync": "tsx scripts/sync-stripe-data.ts",
    "stripe:check-trials": "tsx scripts/check-trial-reminders.ts",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:perf": "k6 run tests/performance/load-test.js",
    "test:all": "npm run lint && npm run type-check && npm run test:coverage && npm run test:e2e",
    "sentry:rules": "node scripts/sentry-alert-rules.mjs",
    "soc2:evidence": "node scripts/soc2-evidence.mjs",
    "soc2:evidence:stdout": "node scripts/soc2-evidence.mjs --stdout",
    "audit:gate": "node scripts/audit-gate.mjs",
    "audit:gate:update": "node scripts/audit-gate.mjs --update",
    "docs:user-guide": "node scripts/generate-user-guide.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:convex-locales": "node scripts/build-convex-locales.mjs",
    "check:convex-locales": "node scripts/build-convex-locales.mjs --check"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.34",
    "@ai-sdk/groq": "^3.0.24",
    "@authenio/samlify-node-xmllint": "^2.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
